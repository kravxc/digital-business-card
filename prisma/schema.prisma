generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile{
  id String @id @default(uuid())
  name String @db.VarChar(120)
  description String @db.Text

  githubUrl String? @db.VarChar(255) @map("github_url")
  linkedinUrl String? @db.VarChar(255) @map("linkedin_url")
  websiteUrl String? @db.VarChar(255) @map("website_url")

  skills Skill[]
  experience Experience[]
  projects Project[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model Skill{
  id String @id @default(uuid())
  name String @db.VarChar(80)
  sortOrder Int @default(0)

  profileId String @map("profile_id")
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([profileId, name])
  @@index([profileId, sortOrder])
  @@map("skills")
}

model Experience {
  id String @id @default(uuid())
  company String @db.VarChar(120)
  position String @db.VarChar(120)
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  achievments String[]
  sortOrder Int @default(0)

  profileId String @map("profile_id")
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt

  @@index([profileId, sortOrder])
  @@index([profileId, startDate])
  @@map("experiences")
  }

  model Project{
    id String @id @default(uuid())
    name String @db.VarChar(120)
    url String? @db.VarChar(255)
    repoUrl String @db.Text
    description String? @db.Text
    sortOrder Int @default(0)

    profileId String @map("profile_id")
    profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([profileId, sortOrder])
    @@map("projects")
  }